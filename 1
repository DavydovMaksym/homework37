#include <iostream>

//std::uniqueptr
template <typename T>
class UniquePtr
{
private:
    T* m_ptr;

public:
    explicit UniquePtr(T* ptr = nullptr) : m_ptr(ptr) {}

    UniquePtr(const UniquePtr&) = delete;
    UniquePtr& operator=(const UniquePtr&) = delete;

    UniquePtr(UniquePtr&& other) noexcept : m_ptr(other.m_ptr)
    {
        other.m_ptr = nullptr;
    }

    UniquePtr& operator=(UniquePtr&& other) noexcept
    {
        if (this != &other)
        {
            delete m_ptr;
            m_ptr = other.m_ptr;
            other.m_ptr = nullptr;
        }
        return *this;
    }

    ~UniquePtr()
    {
        delete m_ptr;
    }

    T& operator*() const
    {
        return *m_ptr;
    }
    T* operator->() const
    {
        return m_ptr;
    }
    T* get() const
    {
        return m_ptr;
    }

    void reset(T* ptr = nullptr)
    {
        delete m_ptr;
        m_ptr = ptr;
    }

    T* release()
    {
        T* temp = m_ptr;
        m_ptr = nullptr;
        return temp;
    }
};

//std::sharedptr
template <typename T>
class SharedPtr
{
private:
    T* m_ptr;
    size_t* m_count;

public:
    explicit SharedPtr(T* ptr = nullptr)
        : m_ptr(ptr), m_count(new size_t(ptr ? 1 : 0)){}

    SharedPtr(const SharedPtr& other)
        : m_ptr(other.m_ptr), m_count(other.m_count)
    {
        if (m_ptr)
        {
            ++(*m_count);
        }
    }

    SharedPtr& operator=(const SharedPtr& other)
    {
        if (this != &other)
        {
            release();
            m_ptr = other.m_ptr;
            m_count = other.m_count;
            if (m_ptr)
            {
                ++(*m_count);
            }
        }
        return *this;
    }

    SharedPtr(SharedPtr&& other) noexcept
        : m_ptr(other.m_ptr), m_count(other.m_count)
    {
        other.m_ptr = nullptr;
        other.m_count = nullptr;
    }

    SharedPtr& operator=(SharedPtr&& other) noexcept
    {
        if (this != &other)
        {
            release();
            m_ptr = other.m_ptr;
            m_count = other.m_count;
            other.m_ptr = nullptr;
            other.m_count = nullptr;
        }
        return *this;
    }

    ~SharedPtr()
    {
        release();
    }

    void release()
    {
        if (m_ptr && m_count)
        {
            if (--(*m_count) == 0)
            {
                delete m_ptr;
                delete m_count;
            }
        }
        m_ptr = nullptr;
        m_count = nullptr;
    }

    size_t use_count() const
    {
        return (m_count ? *m_count : 0);
    }

    T& operator*() const
    {
        return *m_ptr;
    }
    T* operator->() const
    {
        return m_ptr;
    }
    T* get() const
    {
        return m_ptr;
    }
};

struct Student
{
    std::string name;
    int age;
    Student(const std::string& n, int a) : name(n), age(a)
    {
        std::cout << "Student created: " << name << "\n";
    }
    ~Student()
    {
        std::cout << "Student destroyed: " << name << "\n";
    }
    void print()
    {
        std::cout << name << " (" << age << ")\n";
    }
};

int main()
{
    std::cout << "UniquePtr Test:\n";
    {
        UniquePtr<Student> u1(new Student("Ivan", 20));
        u1->print();

        UniquePtr<Student> u2 = std::move(u1);
        if (!u1.get())
        {
            std::cout << "u1 is empty\n";
        }
        u2->print();
    }

    std::cout << "\nSharedPtr Test:\n";
    {
        SharedPtr<Student> s1(new Student("Petro", 21));
        {
            SharedPtr<Student> s2 = s1;
            std::cout << "use_count = " << s1.use_count() << "\n";
            s2->print();
        }
        std::cout << "use_count = " << s1.use_count() << "\n";
    }

    return 0;
}
